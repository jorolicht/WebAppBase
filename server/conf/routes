# Routes
# This file defines all application routes (Higher priority routes first)
# ~~~~

# Helper endpoints
GET        /helper/getMessages           controllers.Helper.getMessages(lang: String ?="")
GET        /helper/getMsg                controllers.Helper.getMsg(msgCode: String, in1:String ?="", in2:String ?="", in3:String ?="")

GET        /helper/send2sse              controllers.Helper.send2sse(id: String, msg: String)

# Hello endpoint
GET        /hello                        controllers.Helper.hello(msg: String)

# WebSocket endpoints
GET        /ws/:slug                     controllers.WebSocketController.socket(slug: String)
GET        /sendmsg                      controllers.WebSocketController.sendmsg(slug: String, msg: String)

# Endpoints managing wordpress custom post types
GET          /wp/post                    controllers.Wordpress.getPost(slug: String ?="", id: Int ?=0, field: String ?="", status: String ?="private")
PUT          /wp/post                    controllers.Wordpress.putPost(slug: String ?="", id: Int ?=0, field: String ?="", status: String ?="private")

