# Application environment configuration for PROD
MY_DOMAIN='example.com'
MY_TITLE='WebAppBase'
MY_EMAIL='admin@example.com'
MY_ADMIN_NAME='admin'
MY_ADMIN_PASS="CHANGE_ME"

MAJOR=0
MINOR=1
PATCH=0
APP_VERSION="${MAJOR}.${MINOR}.${PATCH}"
APP_NAME='webappbase'
APP_HOME='/app'
APP_DATE="2026-11-02"
APP_MAINTAINER="Joe Doe <joe.doe@example.com>"
APP_ORGANIZATION="com.example"
APP_VENDOR="Application Lifecycle Management"
APP_INCLUDE_ADDON="true"
APP_ENVIRONMENT="production"

DEMON_USER=app
DEMON_USERID=1000

DB_NAME='wordpress'
DB_USER='wpuser'
DB_PASSWORD="CHANGE_ME"
DB_ROOT_PASSWORD="CHANGE_ME"

# Database configuration for Play Application
DB_DEFAULT_URL="jdbc:mysql://db:3306/webappdb"
DB_DEFAULT_DRIVER="com.mysql.cj.jdbc.Driver"
DB_DEFAULT_ROOT_PASSWORD="CHANGE_ME"
DB_DEFAULT_USERNAME="playuser"
DB_DEFAULT_PASSWORD="CHANGE_ME"

MAIL_HOST="smtp.example.com"
MAIL_PORT="465"
MAIL_USER="info@example.com"
MAIL_PASS="CHANGE_ME"
MAIL_FROM="info@example.com"
MAIL_FROM_NAME="WebAppBase"
MAIL_ENCRYPTION="ssl"

WP_URL='https://example.com'
WP_TITLE=${MY_TITLE}
WP_ADMIN_USER=${MY_ADMIN_NAME}
WP_ADMIN_PASSWORD="CHANGE_ME"
WP_ADMIN_EMAIL=${MY_EMAIL}
WP_DB_HOST='db:3306'

PLAY_HTTP_PORT="9500" 
PLAY_HTTP_HOST="backend"
PLAY_HTTP_SECRET_KEY="CHANGE_ME"
PLAY_SERVER_URL="http://backend:9500"
PLAY_PIDFILE_PATH="/dev/null"
PLAY_MAILER_HOST=${MAIL_HOST}
PLAY_MAILER_PORT=${MAIL_PORT}
PLAY_MAILER_USER=${MAIL_USER}
PLAY_MAILER_PASSWORD="CHANGE_ME"
PLAY_MAILER_DEBUG="yes"
PLAY_MAILER_MOCK="yes"
PLAY_WP_URL="http://backend:80"
PLAY_WP_CPT="page"

TURNSTILE_SITEKEY="CHANGE_ME"
TURNSTILE_SECRET="CHANGE_ME"
GOOGLE_CLIENT_ID=""

# Backup configuration
GDRIVE_REMOTE="gooDrive"
GDRIVE_FOLDER="backup_webapp_prod"
RETENTION_DAYS="3"

# Social-Media-Links im Footer (vollständige URL, leer = Button ausgeblendet)
SOCIAL_FACEBOOK_URL=""
SOCIAL_X_URL=""
SOCIAL_INSTAGRAM_URL=""
